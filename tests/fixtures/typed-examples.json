    "annot": {
      "lines": [
        "que Pierre est fatigué \\exannot{[CP]}",
        "that Pierre is tired",
        "'that Pierre is tired'"
      ],
      "why": "The \\exannot column: reserved at annot_column_ratio of the text block, the body banded into what is left before it."
    },
    "overlong_word": {
      "lines": [
        "Donaudampfschifffahrtselektrizitätenhauptbetriebswerkbauunterbeamtengesellschaft Rindfleischetikettierungsüberwachungsaufgabenübertragungsgesetz",
        "Danube.steamship.company.electrical.main.works.officials.association beef.labelling.supervision.duties.delegation.law"
      ],
      "why": "Words wider than max_col_cm are capped at it, and two capped words do not fit a 12 cm block: each band must then hold one word. At 17 cm they share a band."
    },
    "paradigm_banded": {
      "lines": [
        "a. Este es un ejemplo mucho mas largo que no cabe en una sola linea de texto de esta pagina",
        "this is a example much more long that not fits in a single line of text of this page",
        "b. Otro corto",
        "another short"
      ],
      "why": "A banded item beside a short one: the grid is the union of every band's and every item's boundaries, each word spanning what it covers."
    },
    "judged_alone": {
      "lines": [
        "* Das kleine Kind schlafen",
        "the little child sleep.INF"
      ],
      "why": "A judgment mark standing alone, a space before the first word: it goes to the judgment column and leaves no empty word behind it in the object tier."
    },
    "annot_long": {
      "lines": [
        "que Pierre est Donaudampfschifffahrtsgesellschaft \\exannot{[CP]}",
        "that Pierre is steamship.company"
      ],
      "why": "An annotated example whose body is squeezed to its available width (at 7 cm a capped word does not fit): the gap left before the annotation column is then exactly \\ExAnnotSep, below min_col_cm, and must still be emitted."
    }
  },
